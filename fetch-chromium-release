#!/bin/bash

set -euo pipefail

readonly VERSION=${1:-}
if [[ ! $VERSION =~ ^[0-9]+\.[0-9]+\.[0-9]+\.[0-9]+$ ]]; then
  echo >&2 'Expected a Chromium version such as 153.0.8010.47'
  exit 1
fi

readonly destination="chromium-$VERSION"
if [[ -e $destination || -L $destination ]]; then
  echo >&2 "Destination already exists: $destination (use a clean makepkg source directory)"
  exit 1
fi

# A self-hosted builder can prefetch the complete source tree once and mount it
# read-only at build time. This keeps GitHub runner connectivity independent
# from the network path used to reach Chromium/Google infrastructure.
if [[ -n ${CHROMIUM_SOURCE_CACHE:-} ]]; then
  readonly cached_source="${CHROMIUM_SOURCE_CACHE}/chromium-${VERSION}"
  if [[ -f "${cached_source}/.ungoogled-chromium-cache-complete" ]]; then
    # The marker also exists in older caches. Check the source version before
    # trusting it, and publish the copy only after cp has completed successfully.
    cached_version=$(awk -F= '
      /^(MAJOR|MINOR|BUILD|PATCH)=/ { v[$1]=$2 }
      END { printf "%s.%s.%s.%s", v["MAJOR"], v["MINOR"], v["BUILD"], v["PATCH"] }
    ' "$cached_source/chrome/VERSION")
    [[ $cached_version == "$VERSION" && -f $cached_source/DEPS ]] || {
      echo >&2 "Incomplete or mismatched Chromium cache: $cached_source"
      exit 1
    }
    echo "Using prefetched Chromium source cache: $cached_source"
    copy_stage=$(mktemp -d ".chromium-$VERSION.copy.XXXXXX")
    trap 'rm -rf -- "$copy_stage"' EXIT
    cp -a --reflink=auto "$cached_source/." "$copy_stage/"
    rm -f "$copy_stage/.ungoogled-chromium-cache-complete"
    mv -T -- "$copy_stage" "$destination"
    trap - EXIT
    exit 0
  fi
fi

retry() {
  local attempts=${1}
  local delay=${2}
  shift 2

  local n=1
  until "$@"; do
    local rc=$?
    if (( n >= attempts )); then
      echo >&2 "Command failed after $n attempts (exit $rc): $*"
      return "$rc"
    fi
    echo >&2 "Attempt $n/$attempts failed (exit $rc); retrying in ${delay}s: $*"
    sleep "$delay"
    ((n++))
  done
}

clone_retry() {
  local dest=${1}
  shift

  local n=1
  local attempts=5
  while true; do
    rm -rf "$dest"
    local rc
    if git clone "$@" "$dest"; then
      return 0
    else
      rc=$?
    fi

    if (( n >= attempts )); then
      echo >&2 "git clone failed after $n attempts: $dest"
      return "$rc"
    fi

    echo >&2 "git clone attempt $n/$attempts failed for $dest; retrying in 15s"
    sleep 15
    ((n++))
  done
}

# Large Chromium fetches are more reliable through HTTP/1.1 on networks or
# proxies that occasionally reset long-lived HTTP/2/TLS streams. Pass these
# settings through Git's environment config so makepkg does not need a writable
# global Git config or HOME; gclient child Git processes inherit them too.
config_count=${GIT_CONFIG_COUNT:-0}
[[ $config_count =~ ^[0-9]+$ ]] || { echo >&2 'Invalid GIT_CONFIG_COUNT'; exit 1; }
export "GIT_CONFIG_KEY_${config_count}=http.version"
export "GIT_CONFIG_VALUE_${config_count}=HTTP/1.1"
export "GIT_CONFIG_KEY_$((config_count + 1))=http.maxRequests"
export "GIT_CONFIG_VALUE_$((config_count + 1))=4"
export GIT_CONFIG_COUNT=$((config_count + 2))

mkdir -p chromium-checkout
cd chromium-checkout
cat >.gclient <<EOF
solutions = [
  {
    "name": "src",
    "url": "https://chromium.googlesource.com/chromium/src.git",
    "managed": False,
    "custom_deps": {},
    "custom_vars": {},
  },
]
EOF

if [[ -d depot_tools/.git ]]; then
  echo "Reusing existing depot_tools checkout"
else
  clone_retry depot_tools --depth=1 https://chromium.googlesource.com/chromium/tools/depot_tools
fi
export PATH+=":$PWD/depot_tools" DEPOT_TOOLS_UPDATE=0

if [[ -d src/.git ]] && git -C src rev-parse --is-inside-work-tree >/dev/null 2>&1; then
  echo "Reusing existing Chromium checkout"
else
  rm -rf src
  clone_retry src -b "$VERSION" --depth=2 https://chromium.googlesource.com/chromium/src
fi

# An interrupted checkout may belong to a different version. Always select the
# requested release before resolving DEPS, including when reusing a checkout.
if ! git -C src rev-parse --verify "refs/tags/$VERSION^{commit}" >/dev/null 2>&1; then
  retry 5 15 git -C src fetch --depth=2 origin "refs/tags/$VERSION:refs/tags/$VERSION"
fi
git -C src checkout --detach "refs/tags/$VERSION"

# gclient sync performs many additional Git/network fetches. Retrying it in
# place allows already completed dependencies to be reused instead of throwing
# away the entire checkout after a transient transport failure.
retry 5 20 gclient sync --no-history --nohooks --revision "src@$VERSION"

src/build/util/lastchange.py -o src/build/util/LASTCHANGE
src/build/util/lastchange.py -m GPU_LISTS_VERSION \
  --revision-id-only --header src/gpu/config/gpu_lists_version.h
src/build/util/lastchange.py -m SKIA_COMMIT_HASH \
  -s src/third_party/skia --header src/skia/ext/skia_commit_hash.h
src/build/util/lastchange.py \
  -s src/third_party/dawn --revision src/gpu/webgpu/DAWN_VERSION
retry 5 20 src/tools/update_pgo_profiles.py --target=linux update \
  --gs-url-base=chromium-optimization-profiles/pgo_profiles

# https://gitlab.archlinux.org/archlinux/packaging/packages/electron32/-/issues/1
retry 5 20 src/third_party/node/update_npm_deps

rm -rf src/third_party/node/linux/node-linux-x64/bin/
find src/third_party/jdk/current -type f -delete
mv -T -- src "../$destination"
