# Copy to ~/.config/ungoogled-chromium-cachyos/build.env and uncomment settings.
# Bash syntax. Environment variables override values saved here.

# Use your proxy's HTTP or mixed listener. The port below is an example.
# CACHYOS_PROXY_URL=http://127.0.0.1:7890
# CACHYOS_DOCKER_NETWORK=auto

# Keep the validated default on the 16 GB laptop.
# CHROMIUM_BUILD_JOBS=8
# CHROMIUM_CACHE_DIR=/path/to/cache
# CACHYOS_IMAGE_PULL=always
# Default output: ~/Downloads/ungoogled-chromium-builds/TIMESTAMP-PID/
# CACHYOS_OUTPUT_DIR must be a new/empty directory for every build.

# Optional: a different runner installation, or a proxy for the runner itself.
# CACHYOS_RUNNER_DIR=/path/to/actions-runner
# CACHYOS_RUNNER_PROXY_URL=http://127.0.0.1:7890
